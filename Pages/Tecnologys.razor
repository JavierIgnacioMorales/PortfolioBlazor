@inject IJSRuntime JS

<div class="tecnology">
    <div class="alltecnology">
        <h1>acá las tecnologías</h1>
    </div>
    <div class="conttexttec">
        <div class="texttecnology" @onclick="toggleTecnology">
            <h1>Herramientas que manejo</h1>
        </div>
    </div>
     <div class="contimagen">
        <div class="imgtecnology"></div> 
    </div> 
</div>

<div class="tecnologyvert">
    <div class="alltecnologyvert">
        <h1>acá las tecnologías</h1>
    </div>
    <div class="conttexttecvert">
        <div class="texttecnology" @onclick="toggleTecnologyvert">
            <h1>Herramientas que manejo</h1>
        </div>
    </div>
    <div class="contimagenvert">
        <div class="imgtecnology"></div>
    </div>
</div>


@code {
    private bool isTecnoVisible = false;
    private bool isTecnoVisiblevert = false;

    private async Task toggleTecnology()
    {
        isTecnoVisible = !isTecnoVisible;
        await JS.InvokeVoidAsync("toggleTecnology", isTecnoVisible);
    }

    private async Task toggleTecnologyvert()
    {
        isTecnoVisiblevert = !isTecnoVisiblevert;
        await JS.InvokeVoidAsync("toggleTecnologyvert", isTecnoVisiblevert);
    }
}

<script src="site.js"></script>
